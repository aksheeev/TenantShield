# Copy this file to .env and adjust values. NEVER commit .env.

APP_NAME=TenantShield
ENVIRONMENT=development
DEBUG=false

# Local Postgres (used by docker-compose)
POSTGRES_USER=tenantshield
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=tenantshield

# Added in later phases:
# DATABASE_URL=postgresql+psycopg://tenantshield:change_me_locally@db:5432/tenantshield
# REDIS_URL=redis://redis:6379/0
# SECRET_KEY=   # generate with: openssl rand -hex 32

DATABASE_URL=postgresql+psycopg://tenantshield:change_me_locally@db:5432/tenantshield
DATABASE_APP_URL=postgresql+psycopg://tenantshield_app:change_me_locally@db:5432/tenantshield
SECRET_KEY=change_this_to_a_real_random_value
